# job-agent v3 — environment
# Copy to .env locally. NEVER commit .env. NEVER paste values into AI chats.

# Supabase (https://supabase.com)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Claude (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL_RANK=claude-haiku-4-5-20251001
CLAUDE_MODEL_TAILOR=claude-sonnet-4-5-20250929
CLAUDE_MODEL_PLAN=claude-sonnet-4-5-20250929

# Telegram (message @BotFather to get token)
TELEGRAM_BOT_TOKEN=...
TELEGRAM_CHAT_ID=...   # the chat_id you message the bot FROM

# Gmail (https://myaccount.google.com/apppasswords — 16-char app password)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=...

# Where tailored .docx files are saved
# DOWNLOADS_DIR defaults to ~/Downloads, uncomment to override

# Supabase Storage bucket for resume_versions.file_url (optional)
RESUMES_BUCKET=resumes

# Tuning
POLL_INTERVAL_SECONDS=30
HEARTBEAT_INTERVAL_SECONDS=60
DAILY_LLM_BUDGET_USD=5.00
ACTIVE_HOURS_START=7
ACTIVE_HOURS_END=22
MIN_RELEVANCE_SCORE=0.4
LOG_LEVEL=INFO